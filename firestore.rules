rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Master Gate: Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Bootstrapped verified admin
    function isAdmin() {
      return isVerified() && request.auth.token.email == 'smongia76@gmail.com';
    }

    // --- Entity Validations ---

    function isValidSakhi(data) {
      return data.keys().hasAll(['title', 'content']) &&
             data.keys().hasOnly(['title', 'content', 'category']) &&
             data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 50000 &&
             (!('category' in data) || (data.category is string && data.category.size() <= 100));
    }

    function isValidQuizQuestion(data) {
      return data.keys().hasAll(['question', 'options', 'correctAnswer']) &&
             data.keys().hasOnly(['question', 'options', 'correctAnswer']) &&
             data.question is string && data.question.size() <= 1000 &&
             data.options is list && data.options.size() > 0 && data.options.size() <= 10 &&
             data.options[0] is string &&
             data.correctAnswer is string && data.correctAnswer.size() <= 500;
    }

    function isValidUserSettings(data) {
      return data.keys().hasAll(['nityaVaniEnabled', 'nityaVaniTime', 'language']) &&
             data.keys().hasOnly([
               'morningEnabled', 'morningTime',
               'eveningEnabled', 'eveningTime',
               'chintanEnabled', 'chintanTime',
               'mantraEnabled', 'mantraTime',
               'nityaVaniEnabled', 'nityaVaniTime',
               'language', 'updatedAt'
             ]) &&
             data.nityaVaniEnabled is bool &&
             data.nityaVaniTime is string && data.nityaVaniTime.size() <= 10 &&
             data.nityaVaniTime.matches('^([01]?[0-9]|2[0-3]):[0-5][0-9]$') &&
             data.language in ['hi', 'pb', 'en'] &&
             (!('morningEnabled' in data) || data.morningEnabled is bool) &&
             (!('morningTime' in data) || (data.morningTime is string && data.morningTime.size() <= 10 && data.morningTime.matches('^([01]?[0-9]|2[0-3]):[0-5][0-9]$'))) &&
             (!('eveningEnabled' in data) || data.eveningEnabled is bool) &&
             (!('eveningTime' in data) || (data.eveningTime is string && data.eveningTime.size() <= 10 && data.eveningTime.matches('^([01]?[0-9]|2[0-3]):[0-5][0-9]$'))) &&
             (!('chintanEnabled' in data) || data.chintanEnabled is bool) &&
             (!('chintanTime' in data) || (data.chintanTime is string && data.chintanTime.size() <= 10 && data.chintanTime.matches('^([01]?[0-9]|2[0-3]):[0-5][0-9]$'))) &&
             (!('mantraEnabled' in data) || data.mantraEnabled is bool) &&
             (!('mantraTime' in data) || (data.mantraTime is string && data.mantraTime.size() <= 10 && data.mantraTime.matches('^([01]?[0-9]|2[0-3]):[0-5][0-9]$'))) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidSearchHistory(data) {
      return data.keys().hasAll(['query', 'timestamp']) &&
             data.keys().hasOnly(['query', 'timestamp']) &&
             data.query is string && data.query.size() > 0 && data.query.size() <= 200 &&
             data.timestamp is timestamp;
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['ownerId', 'name', 'score', 'solvedCount', 'streak', 'accuracy', 'title', 'badge', 'timestamp']) &&
             data.keys().hasOnly(['ownerId', 'name', 'score', 'solvedCount', 'streak', 'accuracy', 'title', 'badge', 'lastSolvedParadox', 'timestamp']) &&
             data.ownerId is string && data.ownerId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 80 &&
             data.score is int && data.score >= 0 && data.score <= 1000000 &&
             data.solvedCount is int && data.solvedCount >= 0 && data.solvedCount <= 100000 &&
             data.streak is int && data.streak >= 0 && data.streak <= 100000 &&
             data.accuracy is int && data.accuracy >= 0 && data.accuracy <= 100 &&
             data.title is string && data.title.size() <= 100 &&
             data.badge is string && data.badge.size() <= 16 &&
             (!('lastSolvedParadox' in data) || (data.lastSolvedParadox is string && data.lastSolvedParadox.size() <= 128)) &&
             data.timestamp is int;
    }

    function isValidSacredPortrait(data) {
      return data.keys().hasAll(['imageData', 'objectFit', 'updatedAt', 'updatedBy']) &&
             data.keys().hasOnly(['imageData', 'objectFit', 'updatedAt', 'updatedBy']) &&
             data.imageData is string && data.imageData.size() >= 10 && data.imageData.size() <= 750000 &&
             data.imageData.matches('^data:image/(jpeg|jpg|png|webp);base64,[A-Za-z0-9+/=]+$') &&
             data.objectFit in ['contain', 'cover'] &&
             data.updatedAt is timestamp && data.updatedAt == request.time &&
             data.updatedBy is string && data.updatedBy == request.auth.token.email && data.updatedBy.size() <= 128;
    }

    // --- Collection Matches ---

    match /test/{docId} {
      allow get: if isValidId(docId);
    }

    match /sacred_config/{configId} {
      allow get: if isValidId(configId) && configId == 'darshan_portrait';
      allow create, update: if isAdmin() && isValidId(configId) && configId == 'darshan_portrait' && isValidSacredPortrait(incoming());
      allow delete: if isAdmin() && isValidId(configId) && configId == 'darshan_portrait';
    }

    match /sakhis/{sakhiId} {
      allow get: if isValidId(sakhiId);
      allow list: if true;
      allow create, update: if isAdmin() && isValidId(sakhiId) && isValidSakhi(incoming());
      allow delete: if isAdmin() && isValidId(sakhiId);
    }

    match /quizQuestions/{questionId} {
      allow get: if isValidId(questionId);
      allow list: if true;
      allow create, update: if isAdmin() && isValidId(questionId) && isValidQuizQuestion(incoming());
      allow delete: if isAdmin() && isValidId(questionId);
    }

    match /ulatvasi_leaderboard/{entryId} {
      allow get: if isValidId(entryId);
      allow list: if true;
      allow create: if isVerified() && isValidId(entryId) && isValidLeaderboardEntry(incoming());
      allow update: if isVerified() && isValidId(entryId) && isValidLeaderboardEntry(incoming()) &&
                       (existing().ownerId == request.auth.uid || isAdmin()) &&
                       incoming().ownerId == existing().ownerId;
      allow delete: if isAdmin() && isValidId(entryId);
    }

    match /users/{userId} {
      match /settings/{settingId} {
        allow get: if isOwner(userId) && isValidId(settingId);
        allow list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isVerified() && isValidId(settingId) && isValidUserSettings(incoming());
        allow delete: if isOwner(userId) && isValidId(settingId);
      }
      match /searchHistory/{searchId} {
        allow get: if isOwner(userId) && isValidId(searchId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isVerified() && isValidId(searchId) && isValidSearchHistory(incoming());
        allow delete: if isOwner(userId) && isValidId(searchId);
      }
    }
  }
}
